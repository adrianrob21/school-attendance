# Run npm run voice:setup once. Raluca High then runs locally without an API key.
# Optional overrides for an existing Piper installation (absolute paths).
# PIPER_PYTHON=/absolute/path/to/python
# PIPER_MODEL=/absolute/path/to/ro_RO-raluca-high.onnx

# Optional production settings for npm run serve.
# HOST=127.0.0.1
# PORT=3000
